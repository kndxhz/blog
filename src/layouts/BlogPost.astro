---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { ClientRouter } from "astro:transitions";

type Props = CollectionEntry<"blog">["data"] & { slug: string };

const { title, description, pubDate, updatedDate, heroImage, tags, slug } = Astro.props;
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} />
    <ClientRouter />
    <style>
      main {
        width: min(100%, 980px);
        margin: 0 auto;
        box-sizing: border-box;
      }
      article {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }
      .hero-image {
        width: 100%;
      }
      .hero-image img {
        display: block;
        margin: 0 auto;
        width: 100%;
        max-height: 420px;
        object-fit: cover;
        border-radius: 24px;
        box-shadow: 0 1px 2px rgba(32, 48, 32, 0.08), 0 10px 28px rgba(32, 48, 32, 0.1);
      }
      .prose {
        width: min(100%, 760px);
        margin: 0 auto;
        padding: 0 0 2rem;
        background: transparent;
        box-shadow: none;
        color: rgb(var(--gray-dark));
      }
      .title {
        margin-bottom: 2rem;
        padding: 1.5rem;
        border-radius: 28px;
        background: var(--surface-container);
        text-align: left;
        line-height: 1.2;
      }
      .title h1 {
        margin: 0;
        font-size: clamp(2rem, 5vw, 3.25rem);
      }
      .description {
        margin: 0.75rem 0 0;
        color: rgb(var(--gray-dark));
        font-size: 1.05rem;
        line-height: 1.75;
      }
      .date {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.9rem;
        padding: 0.3rem 0.75rem;
        border-radius: 999px;
        background: var(--secondary-container);
        color: rgb(var(--gray));
        font-size: 0.9rem;
        line-height: 1.4;
      }
      .last-updated-on {
        color: rgb(var(--gray));
      }
      .tags {
        margin-top: 1rem;
      }
      @media (max-width: 720px) {
        .prose {
          padding-bottom: 1rem;
        }
        .title {
          padding: 1rem;
          border-radius: 20px;
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main transition:animate="fade">
      <article>
        <div class="hero-image">
          {
            heroImage && (
              <Image
                width={1020}
                height={510}
                src={heroImage}
                alt=""
                transition:name={`post-image-${slug}`}
              />
            )
          }
        </div>
        <div class="prose">
          <div class="title">
            <div class="date">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div class="last-updated-on">
                    上次更新在 <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
            <h1 transition:name={`post-title-${slug}`}>{title}</h1>
            <p class="description">{description}</p>
            <div class="tag-list tags" aria-label={`标签: ${tags.join(", ")}`}>
              {tags.map((tag) => <span class="tag-chip">{tag}</span>)}
            </div>
            <hr />
          </div>
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
