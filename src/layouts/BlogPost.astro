---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { ClientRouter } from "astro:transitions";

type Props = CollectionEntry<"blog">["data"] & { slug: string };

const { title, description, pubDate, updatedDate, tags, slug } = Astro.props;
const articleUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)
  .href;
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} />
    <ClientRouter />
    <style>
      main {
        width: min(100%, 980px);
        margin: 0 auto;
        box-sizing: border-box;
      }
      article {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }
      .prose {
        width: min(100%, 760px);
        margin: 0 auto;
        padding: 0 0 2rem;
        background: transparent;
        box-shadow: none;
        color: rgb(var(--gray-dark));
      }
      .title {
        margin-bottom: 1.5rem;
        padding: 0 0 1.25rem;
        border-bottom: 1px solid var(--outline);
        text-align: left;
        line-height: 1.2;
      }
      .title h1 {
        margin: 0;
        font-size: clamp(2rem, 4vw, 3rem);
      }
      .description {
        margin: 0.75rem 0 0;
        color: rgb(var(--gray-dark));
        font-size: 1.05rem;
        line-height: 1.75;
      }
      .date {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.9rem;
        color: rgb(var(--gray));
        font-size: 0.9rem;
        line-height: 1.4;
      }
      .last-updated-on {
        color: rgb(var(--gray));
      }
      .tags {
        margin-top: 1rem;
      }
      .post-license {
        margin-top: 3rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--outline);
        color: rgb(var(--gray));
        font-size: 0.88rem;
        line-height: 1.7;
      }
      .post-license p {
        margin: 0;
        font-size: inherit;
      }
      .post-license p + p {
        margin-top: 0.5rem;
      }
      .post-license a {
        overflow-wrap: anywhere;
      }
      @media (max-width: 720px) {
        .prose {
          padding-bottom: 1rem;
        }
        .title {
          padding-bottom: 1rem;
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main transition:animate="fade">
      <article>
        <div class="prose">
          <div class="title">
            <div class="date">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <span class="last-updated-on">
                    上次更新在 <FormattedDate date={updatedDate} />
                  </span>
                )
              }
            </div>
            <h1 transition:name={`post-title-${slug}`}>{title}</h1>
            <p class="description">{description}</p>
            <div class="tag-list tags" aria-label={`标签: ${tags.join(", ")}`}>
              {tags.map((tag) => <span class="tag-chip">{tag}</span>)}
            </div>
          </div>
          <slot />
          <aside class="post-license" aria-label="文章许可声明">
            <p>
              若无特殊声明，本站点所有文章使用<a
                href="https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode.zh-hans"
                target="_blank"
                rel="noopener noreferrer"
                >知识共享署名-非商业性使用-相同方式共享 4.0 国际许可协议（CC
                BY-NC-SA 4.0）</a
              >授权
            </p>
            <p>
              本文链接：<a href={articleUrl}>{articleUrl}</a>
            </p>
          </aside>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
