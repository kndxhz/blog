---
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { ClientRouter } from "astro:transitions";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
    <link rel="preconnect" href="https://sdk.jinrishici.com" crossorigin />
    <script
      is:inline
      src="https://sdk.jinrishici.com/v2/browser/jinrishici.js"
      charset="utf-8"
      defer></script>
  </head>
  <body>
    <Header />
    <main transition:animate="fade">
      <section class="home-head" aria-labelledby="home-title">
        <div>
          <p id="home-title" class="title">小伙纸的杂货间</p>
          <p class="sub-title">喵喵?喵喵喵?喵喵喵!</p>
        </div>
        <div class="hitokoto-wrap">
          <button
            class="home-hitokoto"
            type="button"
            aria-label="一言"
            aria-expanded="false"
            aria-controls="hitokoto-detail"
          >
            <span class="hitokoto-quote" id="hitokoto-content">
              永远相信美好的事情即将发生
            </span>
            <span class="hitokoto-source" id="hitokoto-source"
              >一言加载中...</span
            >
          </button>
          <aside
            id="hitokoto-detail"
            class="hitokoto-detail"
            aria-live="polite"
            hidden
          >
            <p class="hitokoto-detail-title">诗词详情</p>
            <p id="hitokoto-detail-origin">等待加载...</p>
            <pre id="hitokoto-detail-content"></pre>
            <p id="hitokoto-detail-translate"></p>
          </aside>
        </div>
      </section>
      <section class="home-body">
        <div class="posts">
          <section>
            <ul>
              {
                posts.map((post) => (
                  <li>
                    <a href={`/${post.id}/`}>
                      <div class="post-copy">
                        <h4
                          class="title"
                          transition:name={`post-title-${post.id}`}
                        >
                          {post.data.title}
                        </h4>
                        <p class="excerpt">{post.data.description}</p>
                        <p class="date">
                          <FormattedDate date={post.data.pubDate} />
                        </p>
                        <div
                          class="tag-list"
                          aria-label={`标签: ${post.data.tags.join(", ")}`}
                        >
                          {post.data.tags.map((tag) => (
                            <span class="tag-chip">{tag}</span>
                          ))}
                        </div>
                      </div>
                    </a>
                  </li>
                ))
              }
            </ul>
          </section>
        </div>
      </section>
    </main>

    <Footer />
    <script>
      import "../scripts/homeHitokoto";
    </script>
  </body>
</html>
<style>
  main {
    width: min(100%, 1080px);
    margin: 0 auto;
    box-sizing: border-box;
  }
  .home-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
    gap: 2rem;
    align-items: start;
  }
  .home-head > div {
    min-width: 0;
  }
  .title {
    margin: 0;
    font-size: 2.369rem;
    color: rgb(var(--black));
    line-height: 1.1;
    text-align: left;
  }
  .sub-title {
    margin: 0.5rem 0 0;
    font-size: 1.25rem;
    color: rgb(var(--gray));
    line-height: 1.5;
    text-align: left;
  }
  .home-hitokoto {
    margin: 0;
    padding: 0 0 0 1.25rem;
    border-left: 4px solid var(--primary);
    color: rgb(var(--gray-dark));
    width: min(100%, 24rem);
    min-width: 0;
    box-sizing: border-box;
    cursor: pointer;
    border-top: 0;
    border-right: 0;
    border-bottom: 0;
    background: transparent;
    font: inherit;
    text-align: left;
  }
  .hitokoto-wrap {
    position: relative;
    justify-self: end;
    width: min(100%, 24rem);
    min-width: 0;
  }
  .home-hitokoto:focus-visible {
    outline: 3px solid rgba(56, 106, 59, 0.24);
    outline-offset: 6px;
    border-radius: 8px;
  }
  .home-hitokoto .hitokoto-quote {
    display: -webkit-box;
    margin: 0;
    padding: 0;
    color: rgb(var(--black));
    font-family:
      "LXGW WenKai Screen", "LXGW WenKai", "霞鹜文楷", "STKaiti", "KaiTi", serif;
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    font-weight: 500;
    line-height: 1.55;
    min-height: 3.1em;
    display: -webkit-box;
    overflow: hidden;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .home-hitokoto .hitokoto-quote::before {
    content: "“";
    color: var(--primary);
  }
  .home-hitokoto .hitokoto-quote::after {
    content: "”";
    color: var(--primary);
  }
  .home-hitokoto .hitokoto-source {
    display: block;
    margin-top: 0.65rem;
    color: rgb(var(--gray));
    font-size: 0.9rem;
    text-align: right;
    min-height: 1.4em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hitokoto-detail {
    position: absolute;
    top: 0;
    left: calc(100% + 1rem);
    width: min(24rem, calc(100vw - 4rem));
    box-sizing: border-box;
    padding: 0.9rem 1rem;
    border-radius: 18px;
    background: var(--surface-container);
    box-shadow:
      0 1px 2px rgba(32, 48, 32, 0.08),
      0 8px 22px rgba(32, 48, 32, 0.1);
    cursor: auto;
    min-width: 0;
    overflow: hidden;
    transform-origin: top left;
    transition:
      opacity 0.22s ease,
      transform 0.22s ease,
      max-height 0.22s ease;
    max-height: 0;
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
    pointer-events: none;
  }
  .hitokoto-detail[data-state="open"] {
    max-height: 24rem;
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  .hitokoto-detail[data-state="closing"] {
    max-height: 24rem;
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
  }
  .hitokoto-detail-title {
    margin: 0 0 0.35rem;
    color: var(--primary);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .hitokoto-detail p {
    margin: 0;
    color: rgb(var(--gray-dark));
    font-size: 0.86rem;
    line-height: 1.55;
    white-space: pre-wrap;
  }
  .hitokoto-detail pre {
    margin: 0.55rem 0;
    padding: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    color: rgb(var(--black));
    font-family:
      "LXGW WenKai Screen", "LXGW WenKai", "霞鹜文楷", "STKaiti", "KaiTi", serif;
    font-size: 0.97rem;
    font-weight: 600;
    line-height: 1.7;
    white-space: pre-wrap;
  }
  ul {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    list-style-type: none;
    margin: 0;
    padding: 0;
  }
  ul li {
    min-width: 0;
  }
  ul li a {
    display: block;
    align-items: start;
    min-height: 5.5rem;
    padding: 0.75rem 1rem;
    border-radius: 16px;
    background: transparent;
    box-shadow: none;
    text-decoration: none;
    border-bottom: 1px solid var(--outline);
    transition:
      background-color 0.18s ease,
      color 0.18s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    ul li a:hover {
      background: var(--state-layer);
    }
  }
  ul li a:active,
  ul li a:focus-visible {
    background: var(--state-layer);
  }
  ul li a .title {
    margin: 0;
    color: rgb(var(--black));
    line-height: 1.25;
    font-size: 1.5rem;
  }
  .post-copy {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }
  .excerpt {
    margin: 0;
    color: rgb(var(--gray));
    font-size: 0.95rem;
    line-height: 1.6;
  }
  @media (hover: hover) and (pointer: fine) {
    ul li a:hover .title,
    ul li a:hover .date {
      color: var(--accent-dark);
    }
  }
  ul li a:active .title,
  ul li a:active .date,
  ul li a:focus-visible .title,
  ul li a:focus-visible .date {
    color: var(--accent-dark);
  }
  .date {
    margin: 0;
    color: rgb(var(--gray));
    font-size: 0.95rem;
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.7rem;
  }
  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
    background: var(--secondary-container);
    color: var(--primary);
    font-size: 0.78rem;
    line-height: 1;
  }
  .posts {
    margin-top: 2rem;
    min-width: 0;
    grid-column: 1 / -1;
  }
  .home-body {
    display: block;
  }
  .posts {
    min-width: 0;
  }
  @media (max-width: 720px) {
    ul {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    ul li a {
      padding: 0.75rem 0;
    }
    .post-copy {
      gap: 0.4rem;
    }
    .title,
    .sub-title {
      text-align: left;
    }
    .home-head {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .hitokoto-wrap {
      justify-self: stretch;
      width: 100%;
    }
    .home-hitokoto {
      width: 100%;
      padding-left: 1rem;
    }
    .home-hitokoto .hitokoto-source {
      text-align: left;
    }
    .hitokoto-detail {
      position: static;
      width: 100%;
      margin-top: 0.75rem;
    }
  }
</style>
