---
import chevronLeftIcon from "bootstrap-icons/icons/chevron-left.svg?raw";
import chevronRightIcon from "bootstrap-icons/icons/chevron-right.svg?raw";
import gitIcon from "bootstrap-icons/icons/git.svg?raw";
import houseIcon from "bootstrap-icons/icons/house-fill.svg?raw";
import moonIcon from "bootstrap-icons/icons/moon-fill.svg?raw";
import circleHalfIcon from "bootstrap-icons/icons/circle-half.svg?raw";
import sunIcon from "bootstrap-icons/icons/sun-fill.svg?raw";
import tagsIcon from "bootstrap-icons/icons/tags-fill.svg?raw";
import trainIcon from "bootstrap-icons/icons/train-front-fill.svg?raw";
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";

const commitHash = import.meta.env.PUBLIC_GIT_COMMIT;
const shortCommitHash = commitHash?.slice(0, 7);
---

<header>
  <script>
    import "../scripts/sidebar";
    import "../scripts/theme";
  </script>
  <nav>
    <div class="brand-row">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-copy">
          <span class="brand-title">{SITE_TITLE}</span>
          <span class="brand-subtitle">永远相信美好的事情即将发生</span>
        </span>
      </a>
      <button
        class="sidebar-toggle"
        type="button"
        data-sidebar-toggle
        aria-label="收起侧边栏"
        aria-expanded="true"
      >
        <span
          class="sidebar-icon-collapse"
          aria-hidden="true"
          set:html={chevronLeftIcon}
        />
        <span
          class="sidebar-icon-expand"
          aria-hidden="true"
          set:html={chevronRightIcon}
        />
      </button>
    </div>
    <div class="internal-links">
      <HeaderLink href="/" aria-label="主页">
        <span class="nav-icon" aria-hidden="true" set:html={houseIcon} />
        <span class="nav-label">主页</span>
      </HeaderLink>
      <HeaderLink href="/tags" aria-label="标签">
        <span class="nav-icon" aria-hidden="true" set:html={tagsIcon} />
        <span class="nav-label">标签</span>
      </HeaderLink>
      <a
        href="https://www.travellings.cn/go.html"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="开往-友链接力"
      >
        <span class="nav-icon" aria-hidden="true" set:html={trainIcon} />
        <span class="nav-label">开往</span>
      </a>
    </div>
    <div class="social-links">
      <a href="https://github.com/kndxhz/blog" target="_blank">
        <span class="sr-only">博客的 GitHub 链接</span>
        <svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
          ><path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
          ></path></svg
        >
      </a>
      <button class="theme-toggle" type="button" data-theme-toggle>
        <span class="theme-icon-moon" aria-hidden="true" set:html={moonIcon} />
        <span class="theme-icon-sun" aria-hidden="true" set:html={sunIcon} />
        <span
          class="theme-icon-system"
          aria-hidden="true"
          set:html={circleHalfIcon}
        />
        <span class="sr-only">切换主题</span>
      </button>
      {
        commitHash && (
          <a
            class="commit-link"
            href={`https://github.com/kndxhz/blog/commits/${commitHash}`}
            target="_blank"
            rel="noopener noreferrer"
            title={`查看 commit ${commitHash}`}
          >
            <span class="commit-icon" aria-hidden="true" set:html={gitIcon} />
            <span class="commit-hash" data-full-hash={commitHash}>
              {shortCommitHash}
            </span>
            <span class="sr-only">在 GitHub 查看当前构建的 commits</span>
          </a>
        )
      }
    </div>
  </nav>
</header>
